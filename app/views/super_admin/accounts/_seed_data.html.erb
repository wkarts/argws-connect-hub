<% if ENV.fetch('ENABLE_ACCOUNT_SEEDING', !Rails.env.production?) %>
  <section class="main-content__body">
    <hr/>
    <%= form_for([:seed, namespace, page.resource], method: :post, html: { class: "form" }) do |f| %>
      <div class="form-actions">
        <div>
          <p>Clique no botão para gerar dados de demonstração nesta conta.</p>
          <p class="text-color-red">Atenção: isto apagará todos os dados existentes nesta conta.</p>
        </div>
        <%= f.submit 'Gerar dados de demonstração' %>
      </div>
    <% end %>
  </section>
<% end %>

<section class="main-content__body">
  <hr/>
  <%= form_for([:reset_cache, namespace, page.resource], method: :post, html: { class: "form" }) do |f| %>
    <div class="form-actions">
      <p>Isto limpará as chaves de cache do IndexedDB armazenadas no Redis. <br>No próximo carregamento, os dados serão obtidos novamente do servidor.</p>
      <%= f.submit 'Limpar cache da interface' %>
    </div>
  <% end %>
</section>

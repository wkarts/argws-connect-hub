<%= javascript_pack_tag 'superadmin_pages' %>

<%
  sidebar_icons = {
    accounts: 'icon-building-4-line',
    users: 'icon-user-follow-line',
    platform_apps: 'icon-apps-2-line',
    agent_bots: 'icon-robot-line',
  }

  resource_labels = {
    'accounts' => 'Contas',
    'users' => 'Usuários',
    'platform_apps' => 'Aplicativos da plataforma',
    'agent_bots' => 'Bots de atendimento'
  }

  hidden_resources = %w[
    account_users access_tokens installation_configs dashboard devise/sessions
    app_config app_configs instance_status instance_statuses connect_api settings
    responses response_sources response_documents
  ]
%>

<div class="border-slate-100 border-r w-56 flex-shrink-0 justify-between h-full flex flex-col" role="navigation">
  <div>
    <div class="flex mx-4 mb-4 border-slate-100 border-b py-6">
      <%= link_to image_tag('/brand-assets/logo_thumbnail.svg', alt: 'HUB Administração', class: 'h-10'), super_admin_root_url %>
      <div class="flex flex-col ml-3">
        <div class="text-sm">HUB Admin <%= Hub.version %></div>
        <div class="text-xs text-slate-700 mt-0.5">Administração do sistema</div>
      </div>
    </div>

    <ul class="my-4">
      <%= render partial: "nav_item", locals: { icon: 'icon-grid-line', url: super_admin_root_url, label: 'Visão geral' } %>
      <% Administrate::Namespace.new(namespace).resources.each do |resource| %>
        <% next if hidden_resources.include?(resource.resource) %>
        <%= render partial: "nav_item", locals: {
            icon: sidebar_icons[resource.resource.to_sym],
            url: resource_index_route(resource),
            label: resource_labels.fetch(resource.resource, display_resource_name(resource)),
          }
        %>
      <% end %>
      <hr class="border-slate-100 border-t my-5 mx-4"/>
      <% if InstallationConfig.find_by(name: 'DEPLOYMENT_ENV')&.value == 'cloud' || Rails.env.development? %>
        <%= render partial: "nav_item", locals: { icon: 'icon-folder-3-line', url: super_admin_response_sources_url, label: 'Fontes' } %>
        <%= render partial: "nav_item", locals: { icon: 'icon-draft-line', url: super_admin_response_documents_url, label: 'Documentos' } %>
        <%= render partial: "nav_item", locals: { icon: 'icon-reply-line', url: super_admin_responses_url, label: 'Respostas' } %>
      <% end %>
      <%= render partial: "nav_item", locals: { icon: 'icon-settings-2-line', url: super_admin_installation_configs_url, label: 'Configurações do sistema' } %>
    </ul>
  </div>
  <div>
    <ul class="my-4">
      <% if HubApp.enterprise? %>
        <%= render partial: "nav_item", locals: { icon: 'icon-settings-2-line', url: super_admin_settings_url, label: 'Recursos' } %>
      <% end %>
      <%= render partial: "nav_item", locals: { icon: 'icon-mist-fill', url: sidekiq_web_url, label: 'Processamento em segundo plano' } %>
      <%= render partial: "nav_item", locals: { icon: 'icon-health-book-line', url: super_admin_instance_status_url, label: 'Saúde da instância' } %>
      <%= render partial: "nav_item", locals: { icon: 'icon-plug-connected-line', url: super_admin_connect_api_url, label: 'Connect|API' } %>
      <%= render partial: "nav_item", locals: { icon: 'icon-dashboard-line', url: '/', label: 'Painel de atendimento' } %>
      <%= render partial: "nav_item", locals: { icon: 'icon-logout-circle-r-line', url: super_admin_logout_url, label: 'Sair' } %>
    </ul>
  </div>
</div>

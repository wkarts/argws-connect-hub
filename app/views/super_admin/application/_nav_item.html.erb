<li
  class="px-4 border-l-4 mb-1 <%= current_page?(url) ? 'border-hub-500' : 'border-transparent' %>"
>
  <% text_class_name = current_page?(url) ? 'text-hub-500 bg-slate-25' : 'text-slate-800' %>
  <%= link_to(url, title: label, 'aria-label': label, class: text_class_name + " -ml-1 focus:outline-none cursor-pointer flex items-center px-2 py-1.5 text-slate-800 cursor-pointer hover:text-hub-500 hover:bg-slate-25 rounded-lg") do %>
    <%= hub_admin_icon(icon) %>
    <span class="hub-nav-label ml-2 text-sm"><%= label %></span>
  <% end %>
</li>

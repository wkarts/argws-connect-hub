<% content_for(:title) do %>HUB — Administração<% end %>
<header class="flex mx-8 py-4 items-center border-b border-solid border-slate-100" role="banner">
  <div class="flex flex-col justify-center">
    <h1 class="text-base font-medium leading-6 text-slate-900" id="page-title">🅷🆄🅱 Administração</h1>
    <p class="text-sm font-normal leading-5 text-slate-500 m-0">Configuração local da instalação. Nenhum dado de uso é enviado a serviços de analytics ou telemetria.</p>
  </div>
</header>
<section class="main-content__body">
  <div class="bg-white py-2 px-3">
    <div class="mb-6">
      <h2 class="text-slate-900 font-medium">Instalação</h2>
      <div class="flex items-center mt-3">
        <h4 class="text-sm font-medium text-slate-900 mr-4">Identificador local</h4>
        <span class="text-sm text-slate-600"><%= HubPlatform.installation_identifier %></span>
      </div>
      <div class="flex items-center mt-2">
        <h4 class="text-sm font-medium text-slate-900 mr-4">Plano</h4>
        <span class="text-sm text-slate-600">Community / Autogerenciado</span>
      </div>
    </div>
    <div class="mt-8 py-4"><h3 class="text-slate-900 font-medium text-base">Recursos</h3></div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-x-2 gap-y-3">
      <% SuperAdmin::FeaturesHelper.available_features.each do |feature, attrs| %>
        <div class="border-slate-100 border p-4 rounded-lg relative shadow-sm">
          <span class="<%= attrs[:enabled] ? 'bg-green-400 text-white': 'bg-slate-300 text-slate-800' %> absolute rounded-full p-1 inline-flex right-4 top-5">
            <svg width="14" height="14"><use xlink:href="<%= attrs[:enabled] ? '#icon-tick-line': '#icon-lock-line' %>" /></svg>
          </span>
          <h3 class="text-slate-900 font-medium mt-8"><%= attrs[:name] %></h3>
          <p class="text-slate-600 mb-0"><%= attrs[:description] %></p>
        </div>
      <% end %>
    </div>
  </div>
</section>

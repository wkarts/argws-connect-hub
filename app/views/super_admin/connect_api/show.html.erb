<% content_for(:title) { 'Connect|API' } %>
<header class="main-content__header hub-ops hub-ops-header"><div><h1 class="hub-ops-title"><%= content_for(:title) %></h1><p class="hub-ops-subtitle">Administração das instâncias vinculadas a esta instalação do HUB.</p></div>
  <div class="hub-ops-toolbar"><%= link_to 'Vincular instância existente', super_admin_connect_api_binding_path, class: 'button hub-primary' %><%= link_to 'Reconciliação e importação', super_admin_connect_api_reconciliation_path, class: 'button' %><%= link_to 'Diagnóstico e logs', super_admin_diagnostics_path, class: 'button' %><% if @overview[:manager_url].present? %><%= link_to 'Abrir administração completa', @overview[:manager_url], target: '_blank', rel: 'noopener noreferrer', class: 'button' %><% end %></div>
</header>
<section class="main-content__body hub-ops">
  <% unless @overview[:online] %><div class="hub-alert hub-alert-danger"><strong>Connect|API indisponível:</strong> <%= @overview[:error] %></div><% end %>
  <div class="hub-metrics"><% [[@overview[:version].presence || '—', 'Versão'], [@overview[:total_instances], 'Instâncias desta instalação'], [@overview[:hub_instances], 'Vinculadas a caixas'], [@overview[:connected_instances], 'Conectadas'], [@overview[:call_capable_instances], 'Com capacidade de chamadas']].each do |value, label| %><div class="hub-metric"><strong><%= value %></strong><span><%= label %></span></div><% end %></div>
  <div class="hub-table-wrap"><table class="hub-table-cards"><thead><tr><th>Instância</th><th>HUB</th><th>Integração</th><th>Situação</th><th>Número</th><th>Dados</th><th>Recursos</th><th>Ações</th></tr></thead><tbody>
    <% @overview[:instances].each do |instance| %><tr>
      <td data-label="Instância"><div><strong><%= instance[:name] %></strong><br><small><%= instance[:profile_name].presence || 'Sem nome de perfil' %></small></div></td>
      <td data-label="HUB"><div><% if instance[:hub_managed] %><strong><%= instance[:account_name] %></strong><br><small>Caixa #<%= instance[:inbox_id] %> · <%= instance[:inbox_name] %></small><% else %><small>Instância HUB sem caixa vinculada</small><% end %></div></td>
      <td data-label="Integração"><%= instance[:provider_label] %></td><td data-label="Situação"><%= instance[:status] %></td><td data-label="Número"><%= instance[:number].presence || '—' %></td>
      <td data-label="Dados"><small>Contatos: <%= instance.dig(:counts, :contacts) %><br>Conversas: <%= instance.dig(:counts, :conversations) %><br>Mensagens: <%= instance.dig(:counts, :messages) %></small></td>
      <td data-label="Recursos"><div><% if instance[:calls_supported] %><strong>Chamadas + voz</strong><br><small>Instância: <%= instance[:voip_max_concurrent_calls].presence || 'global' %> / limite: <%= instance[:voip_max_concurrent_calls_limit].presence || '—' %></small>
        <% if instance[:hub_managed] %><form action="<%= update_voip_limit_super_admin_connect_api_path %>" method="post" class="hub-limit"><%= hidden_field_tag :authenticity_token, form_authenticity_token %><%= hidden_field_tag :instance_name, instance[:name] %><%= number_field_tag :voip_max_concurrent_calls, instance[:voip_max_concurrent_calls].presence || instance[:voip_max_concurrent_calls_limit].presence || 1, min: 1, max: instance[:voip_max_concurrent_calls_limit].presence, 'aria-label': 'Limite de chamadas simultâneas' %><%= submit_tag 'Aplicar limite', class: 'button' %></form><% end %>
        <% else %><span>Mensageria</span><% end %></div>
      </td>
      <td data-label="Ações" class="hub-cell-actions"><div class="hub-actions">
        <%= button_to 'Reiniciar', instance_action_super_admin_connect_api_path, method: :post, params: { instance_name: instance[:name], operation: 'restart' }, class: 'button', data: { hub_confirm: 'Reiniciar esta instância? A conexão pode ser interrompida durante a operação.' } %>
        <%= button_to 'Desconectar', instance_action_super_admin_connect_api_path, method: :post, params: { instance_name: instance[:name], operation: 'logout' }, class: 'button hub-warning', data: { hub_confirm: 'Desconectar esta instância do WhatsApp?' } %>
        <% target = { 'WHATSAPP-BAILEYS' => ['WHATSAPP-ZAPO', 'ZAPO'], 'WHATSAPP-ZAPO' => ['WHATSAPP-BAILEYS', 'Baileys'] }[instance[:provider]] %>
        <% if target %><%= button_to "Simular migração → #{target.last}", migrate_provider_super_admin_connect_api_path, method: :post, params: { instance_name: instance[:name], target_provider: target.first, dry_run: true }, class: 'button' %><%= button_to "Migrar → #{target.last}", migrate_provider_super_admin_connect_api_path, method: :post, params: { instance_name: instance[:name], target_provider: target.first, dry_run: false }, class: 'button hub-warning', data: { hub_confirm: "Migrar a sessão para #{target.last}? Faça backup da Connect|API antes desta operação." } %><% end %>
        <% if instance[:hub_managed] %><%= link_to 'Reconciliação', super_admin_connect_api_reconciliation_path(channel_id: @binding_channel_ids[instance[:inbox_id]]), class: 'button' %><%= link_to 'Alterar vínculo da caixa', super_admin_connect_api_binding_path(channel_id: @binding_channel_ids[instance[:inbox_id]]), class: 'button' %><% end %>
        <%= button_to 'Excluir instância', instance_action_super_admin_connect_api_path, method: :post, params: { instance_name: instance[:name], operation: 'delete', confirmation: instance[:name] }, class: 'button hub-danger', data: { hub_confirm: 'Excluir definitivamente esta instância da Connect|API? A caixa ficará sem sessão.', hub_confirm_value: instance[:name] } %>
      </div></td>
    </tr><% end %>
    <% if @overview[:instances].empty? %><tr><td colspan="8" class="hub-empty">Nenhuma instância pertencente a esta instalação do HUB foi encontrada.</td></tr><% end %>
  </tbody></table></div>
  <p class="hub-ops-subtitle"><small>Chaves administrativas e de instância não são exibidas. A vinculação de uma instância existente preserva a caixa e o histórico; não transfere automaticamente a propriedade de outras integrações.</small></p>
</section>

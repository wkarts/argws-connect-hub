# HUB deployment — development/homologação (Connect|API externa)
COMPOSE_PROJECT_NAME=connec-hub-develop

# Imagens públicas no GHCR; nenhum token ou docker login é necessário para o pull.
HUB_IMAGE=ghcr.io/wkarts/argws-connect-hub:develop

# Infraestrutura espelhada pelo próprio projeto HUB no GHCR.
HUB_POSTGRES_IMAGE=ghcr.io/wkarts/hub-postgres:16-alpine
HUB_REDIS_IMAGE=ghcr.io/wkarts/hub-redis:7-alpine
HUB_BIND_ADDRESS=127.0.0.1
HUB_PORT=33000
HUB_NETWORK_NAME=network-connec-hub-develop
HUB_STORAGE_DATA_PATH=./volumes/storage
HUB_POSTGRES_DATA_PATH=./volumes/postgres
HUB_REDIS_DATA_PATH=./volumes/redis
TZ=America/Bahia

# URL pública do HUB (troque os domínios sem alterar o compose)
FRONTEND_URL=https://hub-dev.argws.com.br
FORCE_SSL=true
DEFAULT_LOCALE=pt_BR
ENABLE_ACCOUNT_SIGNUP=false
INSTALLATION_ENV=docker
RAILS_LOG_TO_STDOUT=true
RAILS_SERVE_STATIC_FILES=true
SECRET_KEY_BASE=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET

# Banco exclusivo do HUB
POSTGRES_HOST=postgres-connec-hub-develop
POSTGRES_PORT=5432
POSTGRES_DATABASE=hub_develop
POSTGRES_USERNAME=hub
POSTGRES_PASSWORD=CHANGE_ME_HUB_POSTGRES_PASSWORD

# Redis exclusivo do HUB
REDIS_PASSWORD=CHANGE_ME_HUB_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_HUB_REDIS_PASSWORD@redis-connec-hub-develop:6379/0

# Storage do HUB
ACTIVE_STORAGE_SERVICE=local

# E-mail (preencha quando necessário)
MAILER_SENDER_EMAIL=HUB <no-reply@argws.com.br>
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true

# Connect|API vista pelo HUB
CONNECT_API_AUTH_TOKEN=CHANGE_ME_GENERATE_A_STRONG_CONNECT_API_KEY
CONNECT_API_REQUEST_TIMEOUT=60
CONNECT_API_DEFAULT_PROVIDER=WHATSAPP-BAILEYS

# HUB — diagnóstico, mitigação e confiabilidade Connect|API
HUB_DIAGNOSTICS_ENABLED=true
HUB_DIAGNOSTICS_DIR=/app/log/hub_diagnostics
HUB_DIAGNOSTICS_FILE_BYTES=8388608
HUB_DIAGNOSTICS_FILE_COUNT=8
HUB_DIAGNOSTICS_RETENTION_SECONDS=259200
# all = todos os eventos; session = detalhado apenas durante captura + críticos sempre; errors = somente críticos
HUB_DIAGNOSTICS_CAPTURE_MODE=session
HUB_DIAGNOSTICS_QUEUE_SIZE=2048
HUB_DIAGNOSTICS_DATA_PATH=./volumes/diagnostics
# Compatibilidade legada: não altera o roteamento realtime de mensagens/webhooks.
HUB_CONNECT_RELIABILITY_ENABLED=true
# Recuperação assíncrona: não participa do caminho realtime/webhook.
HUB_CONNECT_RECOVERY_ENABLED=true
# Cada caixa executa no máximo uma varredura a cada 180s, mesmo com cron a cada minuto.
HUB_CONNECT_RECOVERY_MIN_INTERVAL_SECONDS=180
HUB_CONNECT_RECOVERY_MAX_RECORDS=80
HUB_CONNECT_RECOVERY_LOOKBACK_SECONDS=21600
HUB_CONNECT_RECOVERY_HTTP_TIMEOUT_SECONDS=15
HUB_CONNECT_RECOVERY_MAX_RUNTIME_SECONDS=25
HUB_EXISTING_INSTANCE_BINDING_ENABLED=true
HUB_CONNECT_IMPORT_MAX_PAGES=10000
CONNECT_API_PUBLIC_URL=https://connect-dev.argws.com.br
CONNECT_API_MANAGER_PUBLIC_URL=https://connect-dev.argws.com.br/manager
CONNECT_API_BASE_URL=https://connect-dev.argws.com.br

DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILE=5

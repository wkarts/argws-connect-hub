# HUB deployment — produção (Connect|API externa)
COMPOSE_PROJECT_NAME=connec-hub
HUB_IMAGE=ghcr.io/wkarts/argws-connect-hub:latest
HUB_POSTGRES_IMAGE=ghcr.io/wkarts/hub-postgres:16-alpine
HUB_REDIS_IMAGE=ghcr.io/wkarts/hub-redis:7-alpine
HUB_BIND_ADDRESS=127.0.0.1
HUB_PORT=3000
HUB_NETWORK_NAME=network-connec-hub
HUB_STORAGE_VOLUME_NAME=storage-connec-hub
HUB_POSTGRES_VOLUME_NAME=postgres-data-connec-hub
HUB_REDIS_VOLUME_NAME=redis-data-connec-hub
TZ=America/Bahia

# URL pública do HUB (troque os domínios sem alterar o compose)
FRONTEND_URL=https://hub.argws.com.br
FORCE_SSL=true
DEFAULT_LOCALE=pt_BR
ENABLE_ACCOUNT_SIGNUP=false
INSTALLATION_ENV=docker
RAILS_LOG_TO_STDOUT=true
RAILS_SERVE_STATIC_FILES=true
SECRET_KEY_BASE=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET

# Banco exclusivo do HUB
POSTGRES_HOST=postgres-connec-hub
POSTGRES_PORT=5432
POSTGRES_DATABASE=hub_production
POSTGRES_USERNAME=hub
POSTGRES_PASSWORD=CHANGE_ME_HUB_POSTGRES_PASSWORD

# Redis exclusivo do HUB
REDIS_PASSWORD=CHANGE_ME_HUB_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_HUB_REDIS_PASSWORD@redis-connec-hub:6379/0

# Storage do HUB
ACTIVE_STORAGE_SERVICE=local

# E-mail (preencha quando necessário)
MAILER_SENDER_EMAIL=HUB <no-reply@argws.com.br>
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true

# Connect|API vista pelo HUB
CONNECT_API_AUTH_TOKEN=CHANGE_ME_GENERATE_A_STRONG_CONNECT_API_KEY
CONNECT_API_REQUEST_TIMEOUT=60
CONNECT_API_DEFAULT_PROVIDER=WHATSAPP-BAILEYS
CONNECT_API_PUBLIC_URL=https://connect.argws.com.br
CONNECT_API_MANAGER_PUBLIC_URL=https://connect.argws.com.br/manager
CONNECT_API_BASE_URL=https://connect.argws.com.br

DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILE=5

# HUB deployment — produção
COMPOSE_PROJECT_NAME=hub
HUB_IMAGE=ghcr.io/wkarts/argws-connect-hub:latest
HUB_POSTGRES_IMAGE=ghcr.io/wkarts/hub-postgres:16-alpine
HUB_REDIS_IMAGE=ghcr.io/wkarts/hub-redis:7-alpine
HUB_BIND_ADDRESS=127.0.0.1
HUB_PORT=3000
HUB_NETWORK_NAME=hub-net
TZ=America/Bahia

# URL pública do HUB (troque os domínios sem alterar o compose)
FRONTEND_URL=https://hub.argws.com.br
FORCE_SSL=true
DEFAULT_LOCALE=pt_BR
ENABLE_ACCOUNT_SIGNUP=false
INSTALLATION_ENV=docker
RAILS_LOG_TO_STDOUT=true
RAILS_SERVE_STATIC_FILES=true
SECRET_KEY_BASE=CHANGE_ME_GENERATE_A_LONG_RANDOM_SECRET

# Banco exclusivo do HUB
POSTGRES_HOST=hub-postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=hub_production
POSTGRES_USERNAME=hub
POSTGRES_PASSWORD=CHANGE_ME_HUB_POSTGRES_PASSWORD

# Redis exclusivo do HUB
REDIS_PASSWORD=CHANGE_ME_HUB_REDIS_PASSWORD
REDIS_URL=redis://:CHANGE_ME_HUB_REDIS_PASSWORD@hub-redis:6379/0

# Storage do HUB
ACTIVE_STORAGE_SERVICE=local

# E-mail (preencha quando necessário)
MAILER_SENDER_EMAIL=HUB <no-reply@argws.com.br>
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTHENTICATION=login
SMTP_ENABLE_STARTTLS_AUTO=true

# Connect|API vista pelo HUB
CONNECT_API_AUTH_TOKEN=CHANGE_ME_GENERATE_A_STRONG_CONNECT_API_KEY
CONNECT_API_REQUEST_TIMEOUT=60
CONNECT_API_DEFAULT_PROVIDER=WHATSAPP-BAILEYS
CONNECT_API_PUBLIC_URL=https://connect.argws.com.br
CONNECT_API_MANAGER_PUBLIC_URL=https://connect.argws.com.br/manager

DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILE=5

# No modo embutido o compose injeta CONNECT_API_BASE_URL=http://connect-api:8080 no HUB.
ARGWS_CONNECT_API_IMAGE=ghcr.io/wkarts/argws-connect-api:latest
ARGWS_CONNECT_DOCS_IMAGE=ghcr.io/wkarts/argws-connect-docs:latest
CONNECT_API_BIND_ADDRESS=127.0.0.1
CONNECT_API_PORT=38080
CONNECT_DOCS_BIND_ADDRESS=127.0.0.1
CONNECT_DOCS_PORT=38082

# Runtime Connect|API — defaults preservados da develop fornecida
CONNECT_SERVER_NAME=argws-connect-api
CONNECT_NODE_ENV=PROD
CONNECT_LANGUAGE=pt-BR
CONNECT_CORS_ORIGIN=*
CONNECT_CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CONNECT_CORS_CREDENTIALS=false
CONNECT_LOG_QRCODE=true
CONNECT_QRCODE_LIMIT=30
CONNECT_DATABASE_MIGRATION_MAX_ATTEMPTS=60
CONNECT_DATABASE_MIGRATION_RETRY_SECONDS=2
CONNECT_DATABASE_SAVE_DATA_INSTANCE=true
CONNECT_DATABASE_SAVE_DATA_NEW_MESSAGE=true
CONNECT_DATABASE_SAVE_MESSAGE_UPDATE=true
CONNECT_DATABASE_SAVE_DATA_CONTACTS=true
CONNECT_DATABASE_SAVE_DATA_CHATS=true
CONNECT_DATABASE_SAVE_DATA_LABELS=true
CONNECT_DATABASE_SAVE_DATA_HISTORIC=true
CONNECT_DATABASE_SAVE_IS_ON_WHATSAPP=true
CONNECT_DATABASE_SAVE_IS_ON_WHATSAPP_DAYS=7
CONNECT_DATABASE_DELETE_MESSAGE=true
CONNECT_CACHE_REDIS_TTL=604800
CONNECT_CACHE_REDIS_SAVE_INSTANCES=false
CONNECT_CACHE_LOCAL_ENABLED=false
CONNECT_S3_SAVE_VIDEO=true
CONNECT_POSTGRES_MAX_CONNECTIONS=300

# Banco exclusivo da Connect|API
CONNECT_POSTGRES_DATABASE=argws_connect_api
CONNECT_POSTGRES_USERNAME=argws_connect
CONNECT_POSTGRES_PASSWORD=CHANGE_ME_CONNECT_POSTGRES_PASSWORD

# Redis/RabbitMQ/MinIO exclusivos da Connect|API
CONNECT_REDIS_PASSWORD=CHANGE_ME_CONNECT_REDIS_PASSWORD
CONNECT_REDIS_PREFIX_KEY=hub-connect
CONNECT_RABBITMQ_VHOST=hub_connect
CONNECT_RABBITMQ_USER=hub_connect
CONNECT_RABBITMQ_PASSWORD=CHANGE_ME_CONNECT_RABBITMQ_PASSWORD
CONNECT_RABBITMQ_EXCHANGE_NAME=hub_connect
CONNECT_RABBITMQ_GLOBAL_ENABLED=true
CONNECT_MINIO_USER=hub_connect
CONNECT_MINIO_PASSWORD=CHANGE_ME_CONNECT_MINIO_PASSWORD
CONNECT_S3_BUCKET=hub-connect
CONNECT_S3_REGION=us-east-1

# Voz/chamadas: teto global. Cada instância ZAPO pode ter limite <= este valor.
ZAPO_VOIP_MAX_CONCURRENT_CALLS=4

# Barramentos opcionais (habilite também o profile do compose).
CONNECT_NATS_ENABLED=false
CONNECT_NATS_EVENTS_CALL=false
CONNECT_KAFKA_ENABLED=false
CONNECT_KAFKA_EVENTS_CALL=false
CONNECT_WEBHOOK_REQUEST_TIMEOUT_MS=60000
